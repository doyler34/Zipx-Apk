# Copy to `.env` (git-ignored) on the VPS and fill these in.

# Your Real-Debrid API token (https://real-debrid.com/apitoken). Stays on the
# VPS only - it is never returned to the app.
RD_API_KEY=your-real-debrid-token

# Shared secret the ZipX app sends as the "X-Api-Key" header on every request.
# Generate with: openssl rand -hex 24
PREPARE_API_KEY=change-me-random
