# Copy to `.env` (git-ignored) on the VPS and fill these in.

# Your TorBox API key (torbox.app -> Settings -> API). Stays on the VPS only -
# it is never returned to the app.
TORBOX_API_KEY=your-torbox-api-key

# Shared secret the ZipX app sends as the "X-Api-Key" header on every request.
# Generate with: openssl rand -hex 24
PREPARE_API_KEY=change-me-random
