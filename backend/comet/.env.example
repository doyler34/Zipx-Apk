# Copy to `.env` (git-ignored) on the VPS and fill these in.

# Your REGENERATED Real-Debrid API token (make a fresh one at
# https://real-debrid.com/apitoken). Stays on the VPS only.
RD_API_KEY=your-real-debrid-token

# Any long random strings you choose (generate with: openssl rand -hex 16)
COMET_PROXY_PASSWORD=change-me-random
COMET_ADMIN_PASSWORD=change-me-random
